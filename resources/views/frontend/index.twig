{% extends '@frontend/layouts/base.twig' %}

{% block title %}PHP Concept — Modular PHP Runtime{% endblock %}
{% block meta_description %}PHP Concept 2: Core, Extensions, and Stack — assemble capabilities explicitly on PHP 8.4+ and PSR standards{% endblock %}

{% block content %}

{# Hero #}
<section id="hero" class="hero section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <div class="hero-content">
          <p class="hero-eyebrow">PHP 8.4+ · PSR · Explicit wiring</p>
          <h1>Assemble your stack. <span>Nothing enables itself.</span></h1>
          <p>PHP Concept 2 is a modular runtime: a thin Core for the HTTP cycle, composer Extensions for capabilities, and a fluent Stack that registers only what you ask for.</p>
          <div class="hero-actions justify-content-center justify-content-lg-start">
            <a href="#architecture" class="btn-primary">See Architecture</a>
            <a href="#stack" class="btn-video d-flex align-items-center">
              <i class="bi bi-code-slash"></i>
              <span>View Stack API</span>
            </a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="hero-image">
          <div class="layers-card floating" aria-hidden="true">
            <div class="layer-row layer-stack">
              <span class="layer-name">Stack</span>
              <span class="layer-hint">Fluent builders → providers()</span>
            </div>
            <div class="layer-arrow">↑ contracts</div>
            <div class="layer-row layer-ext">
              <span class="layer-name">Extensions</span>
              <div class="layer-badges">
                <span>Http</span><span>View</span><span>Validation</span><span>Session</span><span>…</span>
              </div>
            </div>
            <div class="layer-arrow">↑ contracts</div>
            <div class="layer-row layer-core">
              <span class="layer-name">Core</span>
              <div class="layer-badges">
                <span>App</span><span>HttpKernel</span><span>RouteStrategy</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{# PSR strip #}
<section id="standards" class="clients section">
  <div class="container">
    <div class="row align-items-center justify-content-center g-4 client-row">
      {% for name in ['PSR-3', 'PSR-7', 'PSR-11', 'PSR-15', 'PHP 8.4+'] %}
      <div class="col-4 col-md-2 text-center">
        <span class="badge rounded-pill bg-secondary fs-6">{{ name }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# Architecture #}
<section id="architecture" class="architecture section">
  <div class="container section-title">
    <h2>Architecture</h2>
    <p>Three layers with clear boundaries — not a CMS, not a framework that forces a full stack.</p>
  </div>
  <div class="container">
    <div class="row gy-4">
      <div class="col-lg-4">
        <div class="arch-card">
          <div class="arch-icon"><i class="bi bi-cpu"></i></div>
          <h3>Core</h3>
          <p class="arch-pkg"><code>php-concept/core-2</code></p>
          <p>Minimal HTTP runtime: container, routing, and dispatch. Request → route → handler → response. No View, Session, or Database inside the kernel.</p>
          <ul class="arch-list">
            <li><i class="bi bi-check2"></i> App + League Container</li>
            <li><i class="bi bi-check2"></i> HttpKernel &amp; Router</li>
            <li><i class="bi bi-check2"></i> RouteStrategy &amp; resolvers</li>
          </ul>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="arch-card">
          <div class="arch-icon"><i class="bi bi-puzzle"></i></div>
          <h3>Extensions</h3>
          <p class="arch-pkg"><code>php-concept/extension-*</code></p>
          <p>Separate Composer packages. Add them when the pain appears — not “just in case”. Each ships a ServiceProvider configured via constructor params.</p>
          <ul class="arch-list">
            <li><i class="bi bi-check2"></i> Http, View, Validation</li>
            <li><i class="bi bi-check2"></i> Session, CSRF, Database</li>
            <li><i class="bi bi-check2"></i> Logging, Errors, Console…</li>
          </ul>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="arch-card featured">
          <div class="arch-icon"><i class="bi bi-boxes"></i></div>
          <h3>Stack</h3>
          <p class="arch-pkg"><code>php-concept/stack</code></p>
          <p>Fluent ConceptStack that turns chosen capabilities into an ordered provider list. An explicit assembly recipe — not a hidden global bootstrap.</p>
          <ul class="arch-list">
            <li><i class="bi bi-check2"></i> add(new HttpBrick()) / …</li>
            <li><i class="bi bi-check2"></i> builder() set* / with*</li>
            <li><i class="bi bi-check2"></i> providers() → container</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="architecture-note mt-5">
      <p><strong>Nothing turns on by itself.</strong> If a capability is not in the Stack, its services are not in the container. Core stays thin; domain capabilities live in Extensions.</p>
    </div>
  </div>
</section>

{# Advantages #}
<section id="advantages" class="services section light-background">
  <div class="container section-title">
    <h2>Advantages</h2>
    <p>Why assemble by capability instead of inheriting a monolith.</p>
  </div>
  <div class="container">
    <div class="row gy-4">
      {% set advantages = [
        {icon: 'bi-sliders', title: 'Opt-in capabilities', text: 'API without Twig, CLI without HTTP, tests without a “full framework”. You choose the surface area.'},
        {icon: 'bi-eye', title: 'Visible wiring', text: 'Bootstrap shows exactly what lands in the container. No silent auto-discovery of half the ecosystem.'},
        {icon: 'bi-file-earmark-code', title: 'No config magic in packages', text: 'Extensions do not read a global ConfigInterface. Paths, flags, and connections are explicit arguments from glue code.'},
        {icon: 'bi-diagram-3', title: 'PSR-first runtime', text: 'HTTP, Container, Logging, and friends stay interoperable. Emit stays at the entry point so App is testable without SAPI.'},
        {icon: 'bi-shield-check', title: 'Fail early on dependencies', text: 'Stack builders require() related capabilities (e.g. FormRequest → Validation) before runtime “class not found”.'},
        {icon: 'bi-layers', title: 'Grow when ready', text: 'Start FormSite-thin, add Database or Components later as a conscious Stack change — not a fork of the skeleton.'}
      ] %}
      {% for a in advantages %}
      <div class="col-lg-4 col-md-6">
        <div class="service-card">
          <div class="service-icon"><i class="bi {{ a.icon }}"></i></div>
          <h3>{{ a.title }}</h3>
          <p>{{ a.text }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# Principles #}
<section id="principles" class="features section">
  <div class="container section-title">
    <h2>Principles</h2>
    <p>Rules that keep Bootstrap honest and the container predictable.</p>
  </div>
  <div class="container">
    <div class="row gy-4">
      {% set principles = [
        {icon: 'bi-ban', title: 'What it is not', items: ['Not a CMS', 'Not a forced full stack', 'No “enable everything” switch', 'No package-local config reading']},
        {icon: 'bi-boxes', title: 'Stack naming', items: ['add(new XxxBrick()) — enable', 'builder()->set* — configure', 'with* — opt-in features', 'to* — sinks (e.g. logging)']},
        {icon: 'bi-plug', title: 'Extension wiring', items: ['One ServiceProvider entry', 'Contracts in Contracts/', 'Constructor params for config', 'Own types — no foreign service locator']},
        {icon: 'bi-lightning-charge', title: 'Thin Core', items: ['Container + Route + Dispatch', 'No transitive Extensions', 'Resolvers & interceptors as chains', 'Customize without patching RouteStrategy']}
      ] %}
      {% for p in principles %}
      <div class="col-lg-3 col-md-6">
        <div class="features-card">
          <div class="features-icon"><i class="bi {{ p.icon }}"></i></div>
          <h3>{{ p.title }}</h3>
          <ul class="features-list">
            {% for item in p.items %}
            <li><i class="bi bi-check2"></i> {{ item }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# Capabilities #}
<section id="capabilities" class="portfolio section light-background">
  <div class="container section-title">
    <h2>Capabilities</h2>
    <p>Bricks you enable with <code>add(new XxxBrick())</code> — only when the product needs them.</p>
  </div>
  <div class="container">
    <div class="row gy-4">
      {% set caps = [
        {icon: 'bi-globe2', title: 'Http', text: 'Routes, ResponseFactory, UrlGenerator, FormRequests, typed params'},
        {icon: 'bi-eye', title: 'View', text: 'Twig (or Plates) engines, paths, cache, debug'},
        {icon: 'bi-shield-check', title: 'Validation', text: 'Rules, FormRequest integration, redirect-friendly errors'},
        {icon: 'bi-person-badge', title: 'Session', text: 'File/PDO handlers, flash, CSRF opt-in'},
        {icon: 'bi-database', title: 'Database', text: 'Connections when you are ready — first conscious product add-on'},
        {icon: 'bi-journal-text', title: 'Logging', text: 'Monolog sinks: rotating file, stderr, and friends'},
        {icon: 'bi-bug', title: 'ErrorHandling', text: 'Whoops in debug, view renderers, log reporting'},
        {icon: 'bi-terminal', title: 'Console', text: 'Symfony Console commands for ops and smoke checks'},
        {icon: 'bi-arrow-left-right', title: 'Casting', text: 'Typed payloads via Valinor-backed casting'},
        {icon: 'bi-incognito', title: 'Masking', text: 'Sensitive data redaction across logging and validation'},
        {icon: 'bi-broadcast', title: 'Events / Telemetry', text: 'Observe after you have something worth observing'},
        {icon: 'bi-bricks', title: 'Components', text: 'Product scaffolds (ACL, admin, …) — not platform defaults'}
      ] %}
      {% for c in caps %}
      <div class="col-lg-3 col-md-6">
        <div class="cap-card">
          <div class="cap-icon"><i class="bi {{ c.icon }}"></i></div>
          <h3>{{ c.title }}</h3>
          <p>{{ c.text }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# Stack #}
<section id="stack" class="stack section">
  <div class="container section-title">
    <h2>ConceptStack</h2>
    <p>Fluent assembly instead of dozens of hand-written <code>new XxxServiceProvider(...)</code>.</p>
  </div>
  <div class="container">
    <div class="row align-items-center gy-4">
      <div class="col-lg-6">
        <div class="content">
          <h3>Explicit recipe, ordered providers</h3>
          <p class="lead">Stack does not read config. Every path, flag, and connection array is an argument on a brick method.</p>
          <p><code>add(new XxxBrick())</code> registers the capability; configure via <code>builder()</code>. After assembly, <code>$stack-&gt;providers()</code> returns the ordered list for League Container.</p>
          <div class="stats-row stack-stats">
            <div class="stat-item">
              <h3>add()</h3>
              <p>Enable</p>
            </div>
            <div class="stat-item">
              <h3>set*</h3>
              <p>Configure</p>
            </div>
            <div class="stat-item">
              <h3>with*</h3>
              <p>Opt-in</p>
            </div>
          </div>
          <div class="cta-wrapper">
            <a href="#start" class="btn-cta">
              <span>Choose a starting shape</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <pre class="code-panel" tabindex="0"><code>$stack = ConceptStack::create();

$stack-&gt;add(new LoggingBrick())
    -&gt;builder()
    -&gt;toRotatingFile($logPath);

$stack-&gt;add(new HttpBrick())
    -&gt;builder()
    -&gt;setRoutes([$routes])
    -&gt;withFormRequests();

$stack-&gt;add(new ViewBrick())
    -&gt;builder()
    -&gt;withTwig()
    -&gt;setViewsPath($views);

foreach ($stack-&gt;providers() as $provider) {
    $container-&gt;addServiceProvider($provider);
}</code></pre>
      </div>
    </div>
  </div>
</section>

{# How it works #}
<section id="lifecycle" class="how-we-work section light-background">
  <div class="container section-title">
    <h2>How a request flows</h2>
    <p>A fixed RouteStrategy contract — extend with resolvers and interceptors, do not patch the kernel.</p>
  </div>
  <div class="container">
    <div class="row gy-4">
      {% set steps = [
        {num: '01', title: 'Bootstrap', text: 'Glue builds ConceptStack with explicit arguments and registers providers into the container.'},
        {num: '02', title: 'Dispatch', text: 'App::handle() takes ServerRequest and Router — no framework-guessed stack.'},
        {num: '03', title: 'RouteStrategy', text: 'Interceptors → prepareRequest → argument resolvers → invoke handler → ResponseInterface.'},
        {num: '04', title: 'Emit', text: 'SapiEmitter (or test double) lives at the entry point so the same App runs without SAPI.'}
      ] %}
      {% for step in steps %}
      <div class="col-lg-3 col-md-6">
        <div class="work-step">
          <span class="step-num">{{ step.num }}</span>
          <h3>{{ step.title }}</h3>
          <p>{{ step.text }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# Try it — FormRequest demo #}
<section id="try-it" class="try-it section light-background">
  <div class="container section-title">
    <h2>Try FormRequest</h2>
    <p>Validation, CSRF, flash, and redirect-back — the FormSite surface in one block.</p>
  </div>
  <div class="container">
    <div class="row gy-4 align-items-stretch">
      <div class="col-lg-6">
        <div class="try-copy">
          <h3>What this exercises</h3>
          <ul class="try-list">
            <li><i class="bi bi-shield-check"></i><div><strong>FormRequest rules</strong><span><code>required|min:3</code> on name, <code>required|email</code> on email</span></div></li>
            <li><i class="bi bi-key"></i><div><strong>CSRF protection</strong><span><code>_csrf_token</code> verified on POST before the handler runs</span></div></li>
            <li><i class="bi bi-arrow-return-left"></i><div><strong>Redirect back</strong><span>Invalid input flashes errors + old values and returns to this section</span></div></li>
            <li><i class="bi bi-chat-quote"></i><div><strong>Success flash</strong><span>Valid submit stores a success message and redirects to <code>/#try-it</code></span></div></li>
            <li><i class="bi bi-signpost"></i><div><strong>Also try</strong><span><a href="{{ uri('hello', {name: 'Ada'}) }}">/hello/Ada</a> for a typed route param into Twig</span></div></li>
          </ul>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="try-form-card">
          {% if flashes.success is defined and flashes.success %}
            <div class="try-alert success" role="status">
              {% for message in flashes.success %}
                <p>{{ message }}</p>
              {% endfor %}
            </div>
          {% endif %}
          {% if flashes.error is defined and flashes.error %}
            <div class="try-alert error" role="alert">
              {% for message in flashes.error %}
                <p>{{ message }}</p>
              {% endfor %}
            </div>
          {% endif %}

          <form class="try-form" action="{{ uri('echo') }}#try-it" method="post" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <div class="try-field{% if errors.name is defined %} has-error{% endif %}">
              <label for="echo-name">Name</label>
              <input id="echo-name" type="text" name="name" value="{{ old.name|default('') }}" placeholder="At least 3 characters" autocomplete="name">
              {% if errors.name is defined %}
                <div class="try-field-errors">
                  {% if errors.name is iterable %}
                    {% for message in errors.name %}
                      <span>{{ message }}</span>
                    {% endfor %}
                  {% else %}
                    <span>{{ errors.name }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <div class="try-field{% if errors.email is defined %} has-error{% endif %}">
              <label for="echo-email">Email</label>
              <input id="echo-email" type="email" name="email" value="{{ old.email|default('') }}" placeholder="you@example.com" autocomplete="email">
              {% if errors.email is defined %}
                <div class="try-field-errors">
                  {% if errors.email is iterable %}
                    {% for message in errors.email %}
                      <span>{{ message }}</span>
                    {% endfor %}
                  {% else %}
                    <span>{{ errors.email }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <button type="submit" class="btn-primary">Submit /echo</button>
            <p class="try-hint">Empty submit → validation redirect. Valid submit → success flash on this page.</p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

