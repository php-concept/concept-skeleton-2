{% extends '@frontend/layouts/base.twig' %}

{% block title %}Hello, {{ name }} — PHP Concept{% endblock %}
{% block body_class %}hello-page{% endblock %}

{% block content %}
<section class="error-section section">
  <div class="container">
    <div class="error-panel">
      <div class="error-icon"><i class="bi bi-person-check"></i></div>
      <h1>Hello, {{ name }}</h1>
      <p>Route parameter <code>{{ name }}</code> was resolved and passed into Twig — no FormRequest needed for this GET.</p>
      <div class="error-actions">
        <a href="{{ uri('home') }}#try-it" class="btn-primary">Try the form</a>
        <a href="{{ uri('home') }}" class="btn-secondary">Home</a>
      </div>
    </div>
  </div>
</section>
{% endblock %}
