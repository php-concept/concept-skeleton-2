{% extends '@frontend/layouts/base.twig' %}

{% block title %}500 · Internal Server Error{% endblock %}
{% block meta_description %}Something went wrong on our end.{% endblock %}
{% block body_class %}error-page{% endblock %}

{% block content %}
<section class="error-section section">
  <div class="container">
    <div class="error-panel">
      <div class="error-code" aria-hidden="true">500</div>
      <div class="error-icon"><i class="bi bi-exclamation-octagon"></i></div>
      <h1>Internal server error</h1>
      <p>Something went wrong on our end. We are working to fix it — please try again in a moment.</p>
      <div class="error-actions">
        <a href="{{ uri('home') }}" class="btn-primary">Return Home</a>
        <button type="button" class="btn-secondary" onclick="location.reload()">Retry</button>
      </div>
    </div>
  </div>
</section>
{% endblock %}
