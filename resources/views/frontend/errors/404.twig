{% extends '@frontend/layouts/base.twig' %}

{% block title %}404 · Page Not Found{% endblock %}
{% block meta_description %}The page you requested was not found.{% endblock %}
{% block body_class %}error-page{% endblock %}

{% block content %}
<section class="error-section section">
  <div class="container">
    <div class="error-panel">
      <div class="error-code" aria-hidden="true">404</div>
      <div class="error-icon"><i class="bi bi-compass"></i></div>
      <h1>Page not found</h1>
      <p>The page you are looking for might have been removed, renamed, or is temporarily unavailable.</p>
      <div class="error-actions">
        <a href="{{ uri('home') }}" class="btn-primary">Return Home</a>
        <button type="button" class="btn-secondary" onclick="history.back()">Go Back</button>
      </div>
    </div>
  </div>
</section>
{% endblock %}
