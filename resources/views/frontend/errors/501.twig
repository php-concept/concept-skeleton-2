{% extends '@frontend/layouts/base.twig' %}

{% block title %}501 · Not Implemented{% endblock %}
{% block meta_description %}This feature is not implemented yet.{% endblock %}
{% block body_class %}error-page{% endblock %}

{% block content %}
<section class="error-section section">
  <div class="container">
    <div class="error-panel">
      <div class="error-code" aria-hidden="true">501</div>
      <div class="error-icon"><i class="bi bi-tools"></i></div>
      <h1>Not implemented</h1>
      <p>We know what you are looking for, but this capability is not wired yet. It can be added as a conscious Stack change later.</p>
      <div class="error-actions">
        <a href="{{ uri('home') }}" class="btn-primary">Return Home</a>
        <a href="{{ uri('home') }}#capabilities" class="btn-secondary">Browse capabilities</a>
      </div>
      <p class="error-meta">Status: 501 Not Implemented</p>
    </div>
  </div>
</section>
{% endblock %}
