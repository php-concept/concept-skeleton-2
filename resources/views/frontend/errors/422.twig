{% extends '@frontend/layouts/base.twig' %}

{% block title %}422 · Validation Failed{% endblock %}
{% block meta_description %}The submitted data did not pass validation.{% endblock %}
{% block body_class %}error-page{% endblock %}

{% block content %}
<section class="error-section section">
  <div class="container">
    <div class="error-panel error-panel-wide">
      <div class="error-code" aria-hidden="true">422</div>
      <div class="error-icon"><i class="bi bi-shield-exclamation"></i></div>
      <h1>Validation failed</h1>
      <p>FormRequest rejected the submitted data. Fix the fields below and try again.</p>

      {% if errors is defined and errors %}
      <div class="error-box">
        <h2>Errors</h2>
        <ul>
          {% for field, fieldErrors in errors %}
            {% if fieldErrors is iterable %}
              {% for rule, message in fieldErrors %}
              <li><strong>{{ field }}</strong> — {{ message }}</li>
              {% endfor %}
            {% else %}
              <li><strong>{{ field }}</strong> — {{ fieldErrors }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      {% if old is defined and old %}
      <div class="error-box muted">
        <h2>Submitted values</h2>
        <ul class="old-values">
          {% for key, value in old %}
          <li>
            <span>{{ key }}</span>
            <span>{{ value is same as('') ? '—' : value }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <div class="error-actions">
        <a href="{{ uri('home') }}" class="btn-primary">Return Home</a>
        <button type="button" class="btn-secondary" onclick="history.back()">Go Back</button>
      </div>
    </div>
  </div>
</section>
{% endblock %}
