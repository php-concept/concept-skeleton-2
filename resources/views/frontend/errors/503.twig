{% extends '@frontend/layouts/base.twig' %}

{% block title %}503 · Service Unavailable{% endblock %}
{% block meta_description %}The service is temporarily unavailable.{% endblock %}
{% block body_class %}error-page{% endblock %}

{% block content %}
<section class="error-section section">
  <div class="container">
    <div class="error-panel">
      <div class="error-code" aria-hidden="true">503</div>
      <div class="error-icon"><i class="bi bi-hourglass-split"></i></div>
      <h1>Service unavailable</h1>
      <p>The service is temporarily unavailable. Please try again in a few minutes.</p>
      <div class="error-actions">
        <a href="{{ uri('home') }}" class="btn-primary">Return Home</a>
        <button type="button" class="btn-secondary" onclick="location.reload()">Retry</button>
      </div>
    </div>
  </div>
</section>
{% endblock %}
