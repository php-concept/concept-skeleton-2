<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}PHP Concept{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}PHP Concept 2 — a modular PSR-based PHP runtime: Core, Extensions, and Stack without a forced full stack{% endblock %}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&family=Questrial&display=swap" rel="stylesheet">

  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/assets/css/main.css" rel="stylesheet">

  {% block head %}{% endblock %}
</head>
<body class="{% block body_class %}index-page{% endblock %}">

  {% block header %}
  <header id="header" class="header d-flex align-items-center fixed-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">
      <a href="{{ uri('home') }}" class="logo d-flex align-items-center">
        <img src="/assets/img/logo-mark.svg" alt="PHP Concept">
        <h1 class="sitename">PHP Concept</h1>
      </a>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="{{ uri('home') }}#hero">Home</a></li>
          <li><a href="{{ uri('home') }}#architecture">Architecture</a></li>
          <li><a href="{{ uri('home') }}#advantages">Advantages</a></li>
          <li><a href="{{ uri('home') }}#principles">Principles</a></li>
          <li><a href="{{ uri('home') }}#capabilities">Capabilities</a></li>
          <li><a href="{{ uri('home') }}#stack">Stack</a></li>
          <li><a href="{{ uri('home') }}#start">Get Started</a></li>
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list" aria-label="Toggle navigation"></i>
      </nav>
    </div>
  </header>
  {% endblock %}

  <main class="main">
    {% block content %}{% endblock %}
  </main>

  {% block footer %}
  <footer id="footer" class="footer position-relative light-background">
    <div class="container">
      <div class="row gy-5">
        <div class="col-lg-5">
          <div class="footer-content">
            <a href="{{ uri('home') }}" class="logo d-flex align-items-center mb-4">
              <img src="/assets/img/logo-mark.svg" alt="PHP Concept">
              <span class="sitename">PHP Concept</span>
            </a>
            <p class="mb-4">A modular PHP&nbsp;8.4+ runtime on PSR: a thin Core, separate Extensions, and an explicit Stack — assemble only what your product needs.</p>
          </div>
        </div>

        <div class="col-lg-3 col-6">
          <div class="footer-links">
            <h4>Navigate</h4>
            <ul>
              <li><a href="#architecture"><i class="bi bi-chevron-right"></i> Architecture</a></li>
              <li><a href="#advantages"><i class="bi bi-chevron-right"></i> Advantages</a></li>
              <li><a href="#principles"><i class="bi bi-chevron-right"></i> Principles</a></li>
              <li><a href="#capabilities"><i class="bi bi-chevron-right"></i> Capabilities</a></li>
              <li><a href="#stack"><i class="bi bi-chevron-right"></i> Stack</a></li>
            </ul>
          </div>
        </div>

        <div class="col-lg-4 col-6">
          <div class="footer-links">
            <h4>Layers</h4>
            <ul>
              <li><a href="#architecture"><i class="bi bi-chevron-right"></i> Core</a></li>
              <li><a href="#architecture"><i class="bi bi-chevron-right"></i> Extensions</a></li>
              <li><a href="#stack"><i class="bi bi-chevron-right"></i> ConceptStack</a></li>
              <li><a href="#start"><i class="bi bi-chevron-right"></i> Get started</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <div class="copyright">
              <p>© <span>Copyright</span> <strong class="px-1 sitename">PHP Concept</strong> <span>All Rights Reserved</span></p>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="footer-bottom-links">
              <a href="#architecture">Core · Extensions · Stack</a>
              <a href="#start">Documentation</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </footer>
  {% endblock %}

  <a href="{{ uri('home') }}#hero" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center" aria-label="Scroll to top">
    <i class="bi bi-arrow-up-short"></i>
  </a>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/main.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
